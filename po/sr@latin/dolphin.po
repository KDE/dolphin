#: dolphinmainwindow.cpp:1815
#, kde-format
msgctxt "@action:inmenu File"
msgid "New &Window"
msgstr "Novi &prozor"

#: dolphinmainwindow.cpp:1816
#, kde-format
msgctxt "@info"
msgid "Open a new Dolphin window"
msgstr "Otvori novi prozor Dolphina"

#: dolphinmainwindow.cpp:1818
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"This opens a new window just like this one with the current location.<nl/"
">You can drag and drop items between windows."
msgstr ""
"Ovo otvara novi prozor, baš kao i ovaj, sa trenutnom lokacijom.<nl/>Možete "
"prevlačiti i puštati stavke između prozora."

#: dolphinmainwindow.cpp:1825
#, kde-format
msgctxt "@action:inmenu File"
msgid "New Tab"
msgstr "Novi jezičak"

#: dolphinmainwindow.cpp:1827
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"This opens a new <emphasis>Tab</emphasis> with the current location.<nl/"
">Tabs allow you to quickly switch between multiple locations and views "
"within this window. You can drag and drop items between tabs."
msgstr ""
"Ovo otvara novi <emphasis>jezičak</emphasis> sa trenutnom lokacijom.<nl/"
">Jezičci vam omogućavaju da brzo prelazite između više lokacija i prikaza "
"unutar ovog prozora. Možete prevlačiti i puštati stavke između jezičaka."

#: dolphinmainwindow.cpp:1836
#, kde-format
msgctxt "@action:inmenu Add current folder to places"
msgid "Add to Places"
msgstr "Dodaj u Mesta"

#: dolphinmainwindow.cpp:1838
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid "This adds the selected folder to the Places panel."
msgstr "Ovo dodaje izabranu fasciklu u panel mesta."

#: dolphinmainwindow.cpp:1844
#, kde-format
msgctxt "@action:inmenu File"
msgid "Close Tab"
msgstr "Zatvori jezičak"

#: dolphinmainwindow.cpp:1845
#, kde-format
msgctxt "@info"
msgid "Close Tab"
msgstr "Zatvori jezičak"

#: dolphinmainwindow.cpp:1847
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"This closes the currently viewed tab. If no more tabs are left, this closes "
"the whole window instead."
msgstr ""
"Ovo zatvara trenutno prikazani jezičak. Ako više ne bude jezičaka, ovo "
"umesto toga zatvara ceo prozor."

#: dolphinmainwindow.cpp:1852
#, kde-format
msgctxt "@info:whatsthis quit"
msgid "This closes this window."
msgstr "Ovo zatvara ovaj prozor."

#: dolphinmainwindow.cpp:1861
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para><emphasis>Cut, Copy</emphasis> and <emphasis>Paste</emphasis> work "
"between many applications and are among the most used commands. That's why "
"their <emphasis>keyboard shortcuts</emphasis> are prominently placed right "
"next to each other on the keyboard: <shortcut>Ctrl+X</shortcut>, "
"<shortcut>Ctrl+C</shortcut> and <shortcut>Ctrl+V</shortcut>.</para>"
msgstr ""
"<para><emphasis>Isecanje, kopiranje</emphasis> i <emphasis>nalepljivanje</"
"emphasis> rade između mnogih programa i spadaju u najkorišćenije naredbe. "
"Zato su njihove <emphasis>prečice na tastaturi</emphasis> istaknuto "
"postavljene jedna do druge na tastaturi: <shortcut>Ctrl+X</shortcut>, "
"<shortcut>Ctrl+C</shortcut> i <shortcut>Ctrl+V</shortcut>.</para>"

#: dolphinmainwindow.cpp:1868
#, kde-format
msgctxt "@action"
msgid "Cut…"
msgstr "Iseci…"

#: dolphinmainwindow.cpp:1870
#, kde-kuit-format
msgctxt "@info:whatsthis cut"
msgid ""
"This copies the items in your current selection to the <emphasis>clipboard</"
"emphasis>.<nl/>Use the <emphasis>Paste</emphasis> action afterwards to copy "
"them from the clipboard to a new location. The items will be removed from "
"their initial location."
msgstr ""
"Ovo kopira izabrane stavke u <emphasis>klipbord</emphasis>.<nl/>Zatim "
"koristite radnju <emphasis>Nalepi</emphasis> da biste ih kopirali iz "
"klipborda na novu lokaciju. Stavke će biti uklonjene sa svoje prvobitne "
"lokacije."

#: dolphinmainwindow.cpp:1877
#, kde-format
msgctxt "@action"
msgid "Copy…"
msgstr "Kopiraj…"

#: dolphinmainwindow.cpp:1879
#, kde-kuit-format
msgctxt "@info:whatsthis copy"
msgid ""
"This copies the items in your current selection to the <emphasis>clipboard</"
"emphasis>.<nl/>Use the <emphasis>Paste</emphasis> action afterwards to copy "
"them from the clipboard to a new location."
msgstr ""
"Ovo kopira izabrane stavke u <emphasis>klipbord</emphasis>.<nl/>Zatim "
"koristite radnju <emphasis>Nalepi</emphasis> da biste ih kopirali iz "
"klipborda na novu lokaciju."

#: dolphinmainwindow.cpp:1888
#, kde-format
msgctxt "@action:inmenu Edit"
msgid "Paste"
msgstr "Nalepi"

#: dolphinmainwindow.cpp:1890
#, kde-kuit-format
msgctxt "@info:whatsthis paste"
msgid ""
"This copies the items from your <emphasis>clipboard</emphasis> to the "
"currently viewed folder.<nl/>If the items were added to the clipboard by the "
"<emphasis>Cut</emphasis> action they are removed from their old location."
msgstr ""
"Ovo kopira stavke iz vašeg <emphasis>klipborda</emphasis> u trenutno "
"prikazanu fasciklu.<nl/>Ako su stavke dodate u klipbord radnjom "
"<emphasis>Iseci</emphasis>, one se uklanjaju sa svoje stare lokacije."

#: dolphinmainwindow.cpp:1897
#, kde-format
msgctxt "@action:inmenu"
msgid "Copy to Other View"
msgstr "Kopiraj u drugi prikaz"

#: dolphinmainwindow.cpp:1898
#, kde-format
msgctxt "@action:inmenu"
msgid "Copy to Other View…"
msgstr "Kopiraj u drugi prikaz…"

#: dolphinmainwindow.cpp:1900
#, kde-kuit-format
msgctxt "@info:whatsthis Copy"
msgid ""
"This copies the selected items from the view in focus to the other view. "
"(Only available while in Split View mode.)"
msgstr ""
"Ovo kopira izabrane stavke iz prikaza koji je u fokusu u drugi prikaz. "
"(Dostupno je samo u režimu podeljenog prikaza.)"

#: dolphinmainwindow.cpp:1904
#, kde-format
msgctxt "@action:inmenu Edit"
msgid "Copy to Other View"
msgstr "Kopiraj u drugi prikaz"

#: dolphinmainwindow.cpp:1909
#, kde-format
msgctxt "@action:inmenu"
msgid "Move to Other View"
msgstr "Premesti u drugi prikaz"

#: dolphinmainwindow.cpp:1910
#, kde-format
msgctxt "@action:inmenu"
msgid "Move to Other View…"
msgstr "Premesti u drugi prikaz…"

#: dolphinmainwindow.cpp:1912
#, kde-kuit-format
msgctxt "@info:whatsthis Move"
msgid ""
"This moves the selected items from the view in focus to the other view. "
"(Only available while in Split View mode.)"
msgstr ""
"Ovo premešta izabrane stavke iz prikaza koji je u fokusu u drugi prikaz. "
"(Dostupno je samo u režimu podeljenog prikaza.)"

#: dolphinmainwindow.cpp:1916
#, kde-format
msgctxt "@action:inmenu Edit"
msgid "Move to Other View"
msgstr "Premesti u drugi prikaz"

#: dolphinmainwindow.cpp:1921
#, kde-format
msgctxt "@action:inmenu"
msgid "Focus Other View"
msgstr "Fokusiraj drugi prikaz"

#: dolphinmainwindow.cpp:1922
#, kde-format
msgctxt "@info:tooltip"
msgid "Move keyboard focus to the inactive view."
msgstr "Pomeri fokus tastature na neaktivni prikaz."

#: dolphinmainwindow.cpp:1928
#, kde-format
msgctxt "@action:inmenu Tools"
msgid "Filter…"
msgstr "Filtriraj…"

#: dolphinmainwindow.cpp:1929
#, kde-format
msgctxt "@info:tooltip"
msgid "Show Filter Bar"
msgstr "Prikaži filtersku traku"

#: dolphinmainwindow.cpp:1931
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"This opens the <emphasis>Filter Bar</emphasis> at the bottom of the window."
"<nl/> There you can enter text to filter the files and folders currently "
"displayed. Only those that contain the text in their name will be kept in "
"view."
msgstr ""
"Ovo otvara <emphasis>filtersku traku</emphasis> na dnu prozora.<nl/> Tamo "
"možete uneti tekst za filtriranje fajlova i fascikla koji su trenutno "
"prikazani. Ostaće prikazani samo oni koji sadrže taj tekst u svom imenu."

#: dolphinmainwindow.cpp:1943
#, kde-format
msgctxt "@action:inmenu"
msgid "Toggle Filter Bar"
msgstr "Uključi/isključi filtersku traku"

#: dolphinmainwindow.cpp:1944
#, kde-format
msgctxt "@action:intoolbar"
msgid "Filter"
msgstr "Filtriraj"

# >> @title:window
#: dolphinmainwindow.cpp:1952 search/bar.cpp:216
#, kde-format
msgid "Search…"
msgstr "Traži…"

#: dolphinmainwindow.cpp:1953
#, kde-format
msgctxt "@info:tooltip"
msgid "Search for files and folders"
msgstr "Traži fajlove i fascikle"

#: dolphinmainwindow.cpp:1955
#, kde-kuit-format
msgctxt "@info:whatsthis find"
msgid ""
"<para>This helps you find files and folders by opening a <emphasis>search "
"bar</emphasis>. There you can enter search terms and specify settings to "
"find the items you are looking for.</para>"
msgstr ""
"<para>Ovo vam pomaže da pronađete fajlove i fascikle otvaranjem "
"<emphasis>trake za pretragu</emphasis>. Tamo možete uneti pojmove za "
"pretragu i odrediti postavke kako biste pronašli stavke koje tražite.</para>"

#: dolphinmainwindow.cpp:1964
#, kde-format
msgctxt "@action:inmenu"
msgid "Toggle Search Bar"
msgstr "Uključi/isključi traku za pretragu"

# >> @title:window
