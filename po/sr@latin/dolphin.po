#: admin/workerintegration.cpp:54
#, kde-kuit-format
msgctxt "@info:shell"
msgid ""
"<application>Dolphin</application> requires <application>%1</application> to "
"manage system-controlled files, but it is not installed.<nl/>Press %2 to "
"install <application>%1</application> or %3 to cancel."
msgstr ""
"<application>Dolphin</application> zahteva <application>%1</application> za "
"upravljanje sistemski kontrolisanim fajlovima, ali on nije instaliran.<nl/"
">Pritisnite %2 da instalirate <application>%1</application> ili %3 da "
"otkažete."

