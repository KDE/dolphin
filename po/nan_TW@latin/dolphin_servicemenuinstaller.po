#: servicemenuinstaller.cpp:46
#, kde-format
msgid "Dolphin service menu installation failed"
msgstr "Dolphin ho̍k-bū suán-tuann an-tsong sit-pāi--ah"

#: servicemenuinstaller.cpp:73
#, kde-format
msgid "Failed to install \"%1\", exited with status \"%2\""
msgstr "An-tsong \"%1\" sit-pāi--ah, thè-tshut-bé sī \"%2\""

#: servicemenuinstaller.cpp:102
#, kde-format
msgid "Failed to uninstall \"%1\", exited with status \"%2\""
msgstr "Kái-tû-an-tsong \"%1\" sit-pāi--ah, thè-tshut-bé sī \"%2\""

#: servicemenuinstaller.cpp:114
#, kde-format
msgid "The file does not exist!"
msgstr "Tóng-àn bô tsûn-tsāi!"

#: servicemenuinstaller.cpp:123
#, kde-format
msgid "Unknown error when installing package"
msgstr "An-tsong thò-kiānn ê sî-tsūn huat-sing put-bîng tshò-gōo"

#: servicemenuinstaller.cpp:189
#, kde-format
msgid "Unsupported archive type %1: %2"
msgstr "Bô tsi-uān ê hong-tsûn luī-hîng %1: %2"

#: servicemenuinstaller.cpp:195
#, kde-format
msgid "Failed to run uncompressor command for %1"
msgstr ""

#: servicemenuinstaller.cpp:199
#, kde-format
msgid "Process did not finish in reasonable time: %1 %2"
msgstr "Tîng-sū bô tī tsìng-siông ê sî-kan lāi uân-sîng: %1 %2"

#: servicemenuinstaller.cpp:203
#, kde-format
msgid "Failed to uncompress %1"
msgstr ""

#: servicemenuinstaller.cpp:240
#, kde-format
msgid "Failed to run installer script %1"
msgstr "An-tsong-khì tsí-līng-kó %1 tsip-hîng sit-pāi--ah"

#: servicemenuinstaller.cpp:263
#, kde-format
msgid "Failed to set permissions on %1: %2"
msgstr "%1 ê khuân-hān siat-tīng sit-pāi--ah: %2"

#: servicemenuinstaller.cpp:279
#, kde-format
msgctxt "%2 = comma separated list of arguments"
msgid "Installer script %1 failed, tried arguments \"%2\"."
msgstr "An-tsong-khì tsí-līng-kó %1 sit-pāi--ah, tshì-kuè tsham-sòo \"%2\"."

#: servicemenuinstaller.cpp:281
#, kde-format
msgctxt "Separator between arguments"
msgid "\", \""
msgstr "\", \""

#: servicemenuinstaller.cpp:295
#, kde-format
msgid "Failed to create path %1"
msgstr "Kiàn-li̍p lōo-kìng %1 sit-pāi"

#: servicemenuinstaller.cpp:309
#, kde-format
msgid "Failed to copy .desktop file %1 to %2: %3"
msgstr "Khóo-pih .desktop tóng-àn %1 kàu %2 ê sî-tsūn sit-pāi--ah: %3"

#: servicemenuinstaller.cpp:321 servicemenuinstaller.cpp:429
#, kde-format
msgid "Failed to remove directory %1"
msgstr "Î-tû bo̍k-lo̍k %1 sit-pāi"

#: servicemenuinstaller.cpp:327
#, kde-format
msgid "Failed to create directory %1"
msgstr "Kiàn-li̍p bo̍k-lo̍k %1 sit-pāi"

#: servicemenuinstaller.cpp:366
#, kde-format
msgid "Failed to find an installation script in %1"
msgstr "Tī %1 tshuē-bô an-tsong tsí-līng-kó"

#: servicemenuinstaller.cpp:380
#, kde-format
msgid "Failed to remove .desktop file %1: %2"
msgstr "Î-tû .desktop tóng-àn %1 sit-pāi--ah: %2"

#: servicemenuinstaller.cpp:423
#, kde-format
msgid "Failed to find an uninstallation script in %1"
msgstr "Tī %1 tshuē-bô kái-tû-an-tsong tsí-līng-kó"

#: servicemenuinstaller.cpp:442
#, kde-format
msgctxt "@info:shell"
msgid "Command to execute: install or uninstall."
msgstr ""
"Ài tsip-hîng ê tsí-līng: install (an-tsong) á-sī uninstall (kái-tû-an-tsong)."

#: servicemenuinstaller.cpp:443
#, kde-format
msgctxt "@info:shell"
msgid "Path to archive."
msgstr "Hong-tsûn-tóng ê lōo-kìng."

#: servicemenuinstaller.cpp:448
#, kde-format
msgid "Command is required."
msgstr "Su-iàu tsí-līng."

#: servicemenuinstaller.cpp:451
#, kde-format
msgid "Path to archive is required."
msgstr "Su-iàu hong-tsûn-tóng ê lōo-kìng."

#: servicemenuinstaller.cpp:467
#, kde-format
msgid "Unsupported command %1"
msgstr "Bô-tsi-uān ê tsí-līng %1"
